shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true

# Hoisting de metro*/expo* pra raiz foi tentado e revertido: o Expo tem dois
# consumidores de metro-runtime com versões diferentes e legítimas
# (metro@0.83.3 vs @expo/metro-runtime@4.0.1 -> metro-runtime@0.84.4) — elevar
# tudo pra uma versão só atropelava a resolução correta de um deles. O bug real
# (interop de `export default` do React Native em alguns require() do
# @expo/metro-runtime) foi corrigido via patch — ver patches/ e
# pnpm-workspace.yaml (patchedDependencies).
