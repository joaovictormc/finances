# Template para docker-compose.selfhosted.yml.
# Copie para `.env.selfhosted` (NUNCA commitar o arquivo real — já está no
# .gitignore) e preencha as credenciais reais no host onde for subir
# (ZimaOS 192.168.1.2 ou servidor Linux 192.168.1.4).

# Portas publicadas no host (mude se já estiver usando 3000/3001 pra outra coisa)
API_PORT="3001"
WEB_PORT="3000"

# --- Banco de dados ---
# Cenário A (padrão) — banco já rodando no ZimaOS, acessível pela LAN.
# Use este DATABASE_URL/REDIS_URL tanto rodando no próprio ZimaOS (aponte
# pra 192.168.1.2 mesmo assim, ou "localhost" se preferir) quanto no
# servidor Linux (192.168.1.4), desde que o preflight de conectividade
# (ver docs/deploy.md) tenha confirmado que a porta é alcançável:
DATABASE_URL="postgresql://finances:SENHA@192.168.1.2:5432/finances?schema=public"
REDIS_URL="redis://192.168.1.2:6379"

# Cenário B (fallback) — SEM conectividade com o banco do ZimaOS. Suba com
# `--profile local-db` (ver docker-compose.selfhosted.yml) e troque as duas
# linhas acima por estas, apontando pro nome do serviço local:
# DATABASE_URL="postgresql://finances:SENHA@postgres:5432/finances?schema=public"
# REDIS_URL="redis://redis:6379"

# Credenciais do Postgres/Redis locais — só usadas se subir com --profile local-db
POSTGRES_USER="finances"
POSTGRES_PASSWORD="SENHA"
POSTGRES_DB="finances"

# --- Better Auth ---
BETTER_AUTH_SECRET="change-me-to-a-secure-random-string-min-32-chars"
# BETTER_AUTH_URL fica definido lá embaixo, junto com as outras URLs públicas
# que precisam bater com o endereço real do host (ver seção "URLs públicas").

AUTH_REQUIRE_EMAIL_VERIFICATION="false"

# Bootstrap de conta admin (deixe "false" se este ambiente for exposto além da LAN)
ADMIN_BOOTSTRAP="false"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Google OAuth (opcional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Brevo (email transacional — https://app.brevo.com/)
BREVO_API_KEY=""
EMAIL_FROM_ADDRESS="noreply@yourdomain.com.br"

# Groq API (https://console.groq.com/keys)
GROQ_API_KEY=""

# Telegram Bot (@BotFather)
TELEGRAM_BOT_TOKEN=""

# WhatsApp (Meta Business API — Fase 2)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# Pluggy (integração bancária — Fase 3)
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""

# Mercado Pago (assinaturas/checkout — Fase 6)
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_WEBHOOK_SECRET=""

# --- URL interna da API (rede Docker) ---
# Usada só pelo `web` server-side (next.config.ts rewrites + lib/api-server.ts)
# pra encaminhar chamadas de API por baixo dos panos — NUNCA chega no browser,
# então NÃO precisa bater com o endereço que o usuário digita na barra de
# endereço. "api" é o nome do serviço no docker-compose.selfhosted.yml, sempre
# resolvido pela rede Docker interna, independente de LAN/Tailscale/domínio.
# Só mude se renomear o serviço "api" no compose.
API_INTERNAL_URL="http://api:3001"

# --- URLs públicas (uso: CORS + Better Auth trustedOrigins da API) ---
# O `web` NÃO usa mais essas variáveis no bundle JS (o browser sempre chama
# /api/* no mesmo endereço que carregou a página — ver API_INTERNAL_URL acima)
# — então mudar essas URLs não exige mais rebuild, só recriar o container.
# Elas continuam importantes porque a API (apps/api/src/index.ts e
# lib/auth.ts) as lê em RUNTIME pra montar a allowlist de CORS/trustedOrigins:
# se o `Origin` que o navegador manda não estiver nessa lista, o login quebra
# mesmo com tudo funcionando por baixo.
#
# Ajuste pro IP do host onde subir: 192.168.1.2 ou 192.168.1.4 (só LAN).
# Pra acesso fora da LAN, use o IP Tailscale DESTE host (`tailscale ip -4`)
# — é diferente do IP Tailscale do ZimaOS (100.104.200.37), cada nó tem o seu.
NEXT_PUBLIC_APP_URL="http://192.168.1.4:3000"
API_URL="http://192.168.1.4:3001"
NEXT_PUBLIC_API_URL="http://192.168.1.4:3001"
BETTER_AUTH_URL="http://192.168.1.4:3001"

# Origens extras liberadas no CORS/trustedOrigins da API, além de
# NEXT_PUBLIC_APP_URL — IMPORTANTE: inclua aqui TODO endereço pelo qual o
# `web` pode ser acessado, além do principal acima. Se acessar também pelo
# Tailscale, adicione a origem do `web` nesse endereço (porta do WEB, não da
# API — ex: http://<IP-Tailscale-deste-host>:3000), senão o login trava/falha
# quando acessado por lá mesmo com o proxy same-origin funcionando (Better
# Auth rejeita o `Origin` que não estiver nesta lista).
#
# O app mobile (APK) também precisa de uma entrada aqui: ele fala DIRETO com
# a API (não passa pelo proxy do `web`) e manda Origin = a própria
# EXPO_PUBLIC_API_URL configurada em apps/mobile/eas.json (ver
# apps/mobile/lib/api-client.ts, nativeAuthHeaders) — adicione essa mesma
# origem (protocolo+host+porta da API que o APK usa, ex:
# http://<IP-Tailscale-deste-host>:3001) aqui também, senão o login pelo app
# funciona a nível de rede mas é rejeitado pelo Better Auth.
#
# Lista separada por vírgula, sem espaço, cada uma com protocolo+host+porta
# completos:
LAN_ORIGINS="http://192.168.1.4:3000"
