# Template para docker-compose.selfhosted.yml.
# Copie para `.env.selfhosted` (NUNCA commitar o arquivo real — já está no
# .gitignore) e preencha as credenciais reais no host onde for subir
# (ZimaOS 192.168.1.2 ou servidor Linux 192.168.1.4).

# Portas publicadas no host (mude se já estiver usando 3000/3001 pra outra coisa)
API_PORT="3001"
WEB_PORT="3000"

# --- Banco de dados ---
# Cenário A (padrão) — banco já rodando no ZimaOS, acessível pela LAN.
# Use este DATABASE_URL/REDIS_URL tanto rodando no próprio ZimaOS (aponte
# pra 192.168.1.2 mesmo assim, ou "localhost" se preferir) quanto no
# servidor Linux (192.168.1.4), desde que o preflight de conectividade
# (ver docs/deploy.md) tenha confirmado que a porta é alcançável:
DATABASE_URL="postgresql://finances:SENHA@192.168.1.2:5432/finances?schema=public"
REDIS_URL="redis://192.168.1.2:6379"

# Cenário B (fallback) — SEM conectividade com o banco do ZimaOS. Suba com
# `--profile local-db` (ver docker-compose.selfhosted.yml) e troque as duas
# linhas acima por estas, apontando pro nome do serviço local:
# DATABASE_URL="postgresql://finances:SENHA@postgres:5432/finances?schema=public"
# REDIS_URL="redis://redis:6379"

# Credenciais do Postgres/Redis locais — só usadas se subir com --profile local-db
POSTGRES_USER="finances"
POSTGRES_PASSWORD="SENHA"
POSTGRES_DB="finances"

# --- Better Auth ---
BETTER_AUTH_SECRET="change-me-to-a-secure-random-string-min-32-chars"
BETTER_AUTH_URL="http://192.168.1.4:3001"

AUTH_REQUIRE_EMAIL_VERIFICATION="false"

# Bootstrap de conta admin (deixe "false" se este ambiente for exposto além da LAN)
ADMIN_BOOTSTRAP="false"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Google OAuth (opcional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Brevo (email transacional — https://app.brevo.com/)
BREVO_API_KEY=""
EMAIL_FROM_ADDRESS="noreply@yourdomain.com.br"

# Groq API (https://console.groq.com/keys)
GROQ_API_KEY=""

# Telegram Bot (@BotFather)
TELEGRAM_BOT_TOKEN=""

# WhatsApp (Meta Business API — Fase 2)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# Pluggy (integração bancária — Fase 3)
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""

# Mercado Pago (assinaturas/checkout — Fase 6)
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_WEBHOOK_SECRET=""

# --- URLs públicas ---
# Ajuste pro IP do host onde subir: 192.168.1.2 ou 192.168.1.4 (só LAN).
# Pra acesso fora da LAN, use o IP Tailscale DESTE host (`tailscale ip -4`)
# — é diferente do IP Tailscale do ZimaOS (100.104.200.37), cada nó tem o seu.
NEXT_PUBLIC_APP_URL="http://192.168.1.4:3000"
API_URL="http://192.168.1.4:3001"
NEXT_PUBLIC_API_URL="http://192.168.1.4:3001"
