# Database (PostgreSQL via Tailscale)
DATABASE_URL="postgresql://finances:SENHA@100.104.200.37:5432/finances?schema=public"

# Redis (no ZimaOS via Tailscale — ver docs/setup.md para instalar)
REDIS_URL="redis://100.104.200.37:6379"

# Better Auth
BETTER_AUTH_SECRET="change-me-to-a-secure-random-string-min-32-chars"
# baseURL do Better Auth = onde o handler /api/auth roda (a API, porta 3001)
BETTER_AUTH_URL="http://localhost:3001"
# Verificação de e-mail: "false" em dev/testes (cadastro + login imediato),
# "true" em produção (exige Brevo + Redis para envio do link de confirmação)
AUTH_REQUIRE_EMAIL_VERIFICATION="false"

# Criptografia de campo em repouso (segredos de meio de pagamento, e no futuro
# CPF e tokens de integração). Usada por packages/db/src/crypto.ts, AES-256-GCM.
# Gere uma vez com: openssl rand -base64 32
# NUNCA troque depois que houver dado real gravado — perder a chave = perder o
# dado. Migrar de servidor mantendo os dados exige copiar este valor junto.
APP_ENCRYPTION_KEY="change-me-generate-with-openssl-rand-base64-32"

# Bootstrap de conta admin em dev/testes: ao subir a API, cria (se não existir)
# uma conta com este e-mail/senha. Deixe ADMIN_BOOTSTRAP vazio/"false" em produção.
ADMIN_BOOTSTRAP="false"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Google OAuth (opcional). Preenchidas, mostram "Entrar com Google" no login.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Brevo (email transacional — https://app.brevo.com/ → Settings → API Keys)
# Free: 300 emails/dia (~9.000/mês)
BREVO_API_KEY=""
EMAIL_FROM_ADDRESS="noreply@yourdomain.com.br"

# IA — assistente, insights mensais, sugestão de categoria e leitura de cupom.
# Provedor e modelo de cada função são escolhidos em /admin/ai, sem deploy.
# As chaves também podem ser cadastradas lá (validadas e guardadas
# criptografadas); estas valem como reserva quando o painel está vazio.
# Groq (https://console.groq.com/keys)
GROQ_API_KEY=""
# Claude / Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=""
# Ollama Cloud (https://ollama.com/settings/keys)
OLLAMA_API_KEY=""

# Pluggy (Open Finance) — desligado, fora do produto. O código continua no
# repositório, mas só leria estas chaves com NEXT_PUBLIC_ENABLE_PLUGGY ligado.
# PLUGGY_CLIENT_ID=""
# PLUGGY_CLIENT_SECRET=""

# Mercado Pago (assinaturas/checkout — Fase 6 — https://www.mercadopago.com.br/developers/panel)
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_WEBHOOK_SECRET=""

# App URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
API_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3001"
# Landing page (apps/landing)
# Na API: origem liberada no CORS e endereço avisado ao publicar no admin.
LANDING_URL="http://localhost:3002"
# Mesmo valor na API e na landing: protege a rota /api/revalidate da landing.
LANDING_REVALIDATE_SECRET=""
# Assina os links de pré-visualização do rascunho (opcional; cai no BETTER_AUTH_SECRET).
LANDING_PREVIEW_SECRET=""
# No app web: endereço público da landing (botões Pré-visualizar / Ver no site).
NEXT_PUBLIC_LANDING_URL="http://localhost:3002"
