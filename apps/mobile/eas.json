{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.1.4:3011",
        "EXPO_PUBLIC_LANDING_URL": "http://192.168.1.4:3012"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://100.84.104.128:3011",
        "EXPO_PUBLIC_LANDING_URL": "http://100.84.104.128:3012"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.SEUDOMINIO.com.br",
        "EXPO_PUBLIC_LANDING_URL": "https://SEUDOMINIO.com.br"
      }
    }
  }
}
