// This is the Prisma schema for the finances SaaS.
// TimescaleDB is used for the transactions hypertable (time-series performance).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// IDENTITY (Better Auth managed + app profile)
// ─────────────────────────────────────────────

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  role          String    @default("user") // user | support | admin
  twoFactorEnabled Boolean @default(false)
  createdAt     DateTime
  updatedAt     DateTime

  // Better Auth relations
  sessions   Session[]
  accounts   Account[]
  twoFactor  TwoFactor?

  // App relations
  profile         UserProfile?
  ownedGroups     Group[]           @relation("GroupOwner")
  groupMemberships GroupMember[]
  financialAccounts FinancialAccount[]
  customCategories  Category[]
  transactions    Transaction[]
  budgets         Budget[]
  goals           Goal[]
  recurringBills  RecurringBill[]
  ofConsents      OpenFinanceConsent[]
  botConversations BotConversation[]
  notifications   Notification[]
  aiInsights      AiInsight[]
  subscription    Subscription?
  referralCode    ReferralCode?
  referralsMade   Referral[]        @relation("Referrer")
  referredBy      Referral?         @relation("Referred")
  aiUsageLogs     AiUsageLog[]
  gamificationProfile GamificationProfile?
  gamificationSpinLogs GamificationSpinLog[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("accounts")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verifications")
}

model UserProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Nenhuma rota grava esse campo hoje (não há UI/endpoint de coleta de
  // CPF) — quando for implementado, gravar com encryptField/decryptField
  // de @finances/db (packages/db/src/crypto.ts), não em texto puro.
  cpf             String?
  phoneE164       String?   // e.g. +5511999999999
  telegramChatId  BigInt?   @unique
  whatsappPhone   String?   @unique

  defaultCurrency String    @default("BRL")
  timezone        String    @default("America/Sao_Paulo")
  aiInsightsEnabled Boolean @default(true)
  notifyEmail     Boolean   @default(true)
  notifyTelegram  Boolean   @default(true)
  onboardingCompletedAt DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("user_profiles")
}

model TwoFactor {
  id          String  @id @default(cuid())
  secret      String
  backupCodes String
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified    Boolean @default(true)

  @@map("two_factor")
}

// ─────────────────────────────────────────────
// GROUPS (family / shared finance)
// ─────────────────────────────────────────────

model Group {
  id         String   @id @default(cuid())
  name       String
  ownerId    String
  owner      User     @relation("GroupOwner", fields: [ownerId], references: [id])
  inviteCode String   @unique @default(cuid())
  createdAt  DateTime @default(now())

  members         GroupMember[]
  financialAccounts FinancialAccount[]
  transactions    Transaction[]
  budgets         Budget[]
  goals           Goal[]

  @@map("groups")
}

model GroupMember {
  groupId  String
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("member") // owner | admin | member | viewer
  joinedAt DateTime @default(now())

  @@id([groupId, userId])
  @@map("group_members")
}

// ─────────────────────────────────────────────
// CORE FINANCE
// ─────────────────────────────────────────────

model FinancialAccount {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId     String?
  group       Group?   @relation(fields: [groupId], references: [id])

  // account details
  type        String   // checking | savings | credit_card | investment | wallet
  hasCreditCard Boolean @default(false) // permite importar fatura de cartão (paymentMethod: credit) na mesma conta
  name        String
  institution String?  // Nubank, Itaú, etc.
  currency    String   @default("BRL")
  color       String?
  icon        String?
  isArchived  Boolean  @default(false)

  // Open Finance Brasil link
  openFinanceAccountId String?

  // Pluggy fallback link
  pluggyItemId    String?
  pluggyAccountId String? @unique

  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())

  transactions      Transaction[]
  recurringBills    RecurringBill[]
  goals             Goal[]
  openFinanceAccounts OpenFinanceAccount[]

  @@map("financial_accounts")
}

model Category {
  id       String  @id @default(cuid())
  userId   String? // null = system category
  user     User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  name     String
  icon     String?
  color    String?
  type     String  // income | expense | transfer
  isSystem Boolean @default(false)

  createdAt DateTime @default(now())

  transactions   Transaction[]
  budgets        Budget[]
  recurringBills RecurringBill[]

  @@map("categories")
}

// Note: After migration, run:
// SELECT create_hypertable('transactions', 'date', if_not_exists => TRUE);
model Transaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String
  account     FinancialAccount @relation(fields: [accountId], references: [id])
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  groupId     String?
  group       Group?   @relation(fields: [groupId], references: [id])

  type        String   // income | expense | transfer
  paymentMethod String @default("debit") // debit | credit (cartão vinculado à conta) | pix | cash | boleto
  amount      Decimal  @db.Decimal(15, 2)
  currency    String   @default("BRL")
  description String
  notes       String?
  date        DateTime @db.Date

  // Source tracking
  source      String   @default("manual") // manual | open_finance | telegram | whatsapp | import
  externalId  String?  // bank's transaction ID (for dedup)
  rawDescription String? // original bank description before AI categorization

  // AI enrichment
  aiCategoryConfidence Decimal? @db.Decimal(4, 3)
  aiMerchantName       String?
  aiTags               String[] @default([]) // ['supermercado', 'alimentação']

  // Transfer link
  transferPairId String?

  // Recurrence
  recurringBillId String?
  recurringBill   RecurringBill? @relation(fields: [recurringBillId], references: [id])

  isIgnored   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  botMessages BotMessage[]

  @@unique([externalId, accountId])
  @@index([userId, date])
  @@index([accountId, date])
  @@map("transactions")
}

model Budget {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId    String?
  group      Group?   @relation(fields: [groupId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  name           String
  amount         Decimal @db.Decimal(15, 2)
  period         String  @default("monthly") // weekly | monthly | yearly
  startDate      DateTime @db.Date
  endDate        DateTime? @db.Date
  alertThreshold Decimal @default(0.80) @db.Decimal(4, 3)

  createdAt DateTime @default(now())

  @@map("budgets")
}

model RecurringBill {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  accountId  String?
  account    FinancialAccount? @relation(fields: [accountId], references: [id])

  name            String
  expectedAmount  Decimal?  @db.Decimal(15, 2)
  amountVariance  Decimal?  @db.Decimal(15, 2)
  frequency       String    // monthly | weekly | annual | custom
  dayOfMonth      Int?
  nextDueDate     DateTime? @db.Date
  lastPaidDate    DateTime? @db.Date
  merchantPattern String?   // regex / string to detect in transaction descriptions
  isActive        Boolean   @default(true)

  createdAt DateTime @default(now())

  transactions Transaction[]

  @@map("recurring_bills")
}

model Goal {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId    String?
  group      Group?   @relation(fields: [groupId], references: [id])
  linkedAccountId String?
  linkedAccount   FinancialAccount? @relation(fields: [linkedAccountId], references: [id])

  name          String
  description   String?
  targetAmount  Decimal @db.Decimal(15, 2)
  currentAmount Decimal @default(0) @db.Decimal(15, 2)
  targetDate    DateTime? @db.Date
  icon          String?
  color         String?
  isCompleted   Boolean @default(false)

  createdAt DateTime @default(now())

  @@map("goals")
}

// ─────────────────────────────────────────────
// OPEN FINANCE BRASIL
// ─────────────────────────────────────────────

model OpenFinanceConsent {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bankIspb  String // e.g. '60701190' for Itaú
  bankName  String

  consentId   String @unique // urn:amazingbank:... format
  status      String // AWAITING_AUTHORISATION | AUTHORISED | REJECTED | REVOKED
  permissions String[]

  // Fluxo Open Finance não está implementado hoje (nenhuma rota
  // lê/escreve esses campos — a integração ativa é via Pluggy). Se for
  // implementado, gravar com encryptField/decryptField de @finances/db
  // (packages/db/src/crypto.ts), nunca em texto puro — o "Enc" no nome do
  // campo é a intenção original, não uma garantia atual.
  accessTokenEnc  String?
  refreshTokenEnc String?
  tokenExpiresAt  DateTime?

  lastSyncAt DateTime?
  syncError  String?
  syncCursor String?

  createdAt DateTime  @default(now())
  revokedAt DateTime?

  ofAccounts OpenFinanceAccount[]

  @@map("open_finance_consents")
}

model OpenFinanceAccount {
  id        String @id @default(cuid())
  consentId String
  consent   OpenFinanceConsent @relation(fields: [consentId], references: [id], onDelete: Cascade)
  financialAccountId String?
  financialAccount   FinancialAccount? @relation(fields: [financialAccountId], references: [id])

  ofAccountId   String // bank's accountId
  ofAccountType String // CACC | SVGS | CARD
  brandName     String?
  branchCode    String?
  numberLast4   String?
  checkDigit    String?

  balance          Decimal?  @db.Decimal(15, 2)
  balanceUpdatedAt DateTime?

  createdAt DateTime @default(now())

  @@map("open_finance_accounts")
}

// ─────────────────────────────────────────────
// BOTS + NOTIFICATIONS
// ─────────────────────────────────────────────

model BotConversation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  platform       String // telegram | whatsapp
  platformChatId String

  state   String @default("idle") // idle | awaiting_amount | awaiting_category | awaiting_confirmation | nl_query
  context Json?  // pending transaction data, partial parse result

  lastMessageAt DateTime @default(now())

  messages BotMessage[]

  @@unique([platform, platformChatId])
  @@map("bot_conversations")
}

model BotMessage {
  id             String @id @default(cuid())
  conversationId String
  conversation   BotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  direction   String // inbound | outbound
  messageType String // text | audio | image
  content     String?
  rawPayload  Json?

  // AI processing
  parsedIntent String? // record_expense | record_income | query | unknown
  parsedData   Json?
  aiConfidence Decimal? @db.Decimal(4, 3)

  resultedInTransactionId String?
  resultedInTransaction   Transaction? @relation(fields: [resultedInTransactionId], references: [id])

  createdAt DateTime @default(now())

  @@map("bot_messages")
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String // bill_reminder | budget_alert | overdraft_warning | sync_complete | new_transaction | insight_ready | goal_milestone
  channel String // email | telegram | whatsapp | push
  title   String
  body    String
  metadata Json?

  status  String    @default("pending") // pending | sent | failed | read
  sentAt  DateTime?
  readAt  DateTime?
  error   String?

  createdAt DateTime @default(now())

  @@index([userId, status])
  @@map("notifications")
}

model AiInsight {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     String // monthly_summary | spending_anomaly | recurring_detected | overdraft_risk | savings_opportunity | budget_forecast | weekly_recap | streak_milestone
  title    String
  body     String // markdown
  data     Json?
  severity String @default("info") // info | warning | success | critical

  periodStart DateTime? @db.Date
  periodEnd   DateTime? @db.Date

  isRead      Boolean @default(false)
  isDismissed Boolean @default(false)
  generatedAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("ai_insights")
}

// ─────────────────────────────────────────────
// GAMIFICAÇÃO
// ─────────────────────────────────────────────

model GamificationProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  points          Int       @default(0)
  level           Int       @default(1)
  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  lastActivityDate DateTime? @db.Date
  lastSpinAt      DateTime?

  unlockedBadges String[] @default([]) // slugs do catálogo estático de emblemas resgatados com pontos
  activeBadge    String?                // slug do emblema em exibição (perto do nome) — precisa estar em unlockedBadges

  updatedAt DateTime @updatedAt

  @@map("gamification_profiles")
}

/** Histórico de cada giro real da Roleta Semanal (grátis ou comprado com pontos) — auditoria + estatísticas reais de uso. */
model GamificationSpinLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  prizeLabel  String
  prizePoints Int
  source      String // "weekly" (giro grátis semanal) | "purchased" (giro avulso comprado com pontos)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("gamification_spin_logs")
}

// ─────────────────────────────────────────────
// MONETIZAÇÃO (Mercado Pago)
// ─────────────────────────────────────────────

model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   String @default("free") // free | pro | familia
  status String @default("active") // active | past_due | canceled

  mpPreapprovalId String? @unique // id da assinatura recorrente no Mercado Pago

  currentPeriodEnd DateTime?
  canceledAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

model PaymentEvent {
  id         String @id @default(cuid())
  mpEventId  String @unique // id do evento/pagamento do Mercado Pago (idempotência do webhook)
  type       String
  rawPayload Json

  processedAt DateTime @default(now())

  @@map("payment_events")
}

model ReferralCode {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  code   String @unique @default(cuid())

  createdAt DateTime @default(now())

  @@map("referral_codes")
}

model Referral {
  id         String @id @default(cuid())
  referrerId String
  referrer   User   @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId String @unique
  referred   User   @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)

  rewardGranted Boolean @default(false)
  createdAt     DateTime @default(now())

  @@map("referrals")
}

// ─────────────────────────────────────────────
// ADMIN / IA (configuração e observabilidade)
// ─────────────────────────────────────────────

model AiSettings {
  id String @id @default("singleton") // linha única de configuração global

  // A Groq aposenta modelos com frequência — os `llama-3.x` saíram do catálogo em
  // 08/2026 e passaram a responder 404 / model_decommissioned. Os três ids são
  // editáveis em /admin/ai sem deploy; confira os vigentes em
  // console.groq.com/docs/models antes de trocar.
  textModel   String @default("openai/gpt-oss-120b")
  audioModel  String @default("whisper-large-v3-turbo")
  visionModel String @default("qwen/qwen3.8-27b") // multimodal: aceita imagem + JSON mode

  expenseParsingEnabled     Boolean @default(true) // parsing de mensagens do bot (texto/voz)
  monthlyInsightsEnabled    Boolean @default(true) // geração de insight mensal
  nlQueryEnabled            Boolean @default(true) // POST /api/ai/query
  categorySuggestionEnabled Boolean @default(true) // POST /api/transactions/suggest-categories
  receiptScanEnabled        Boolean @default(true) // POST /api/transactions/receipt-scan (kill-switch)

  monthlyTokenLimit Int? // null = ilimitado; soma de prompt+completion tokens do mês corrente
  // Teto de gasto do mês em USD, só para o medidor em /admin/ai: serve de
  // denominador da barra e base do alerta. Não bloqueia chamadas — quem corta
  // o uso é o monthlyTokenLimit, via isWithinUsageLimit().
  monthlyBudgetUsd Float?

  updatedAt DateTime @updatedAt

  @@map("ai_settings")
}

/** Configuração dos prêmios da Roleta Semanal (gamificação) — o admin define os valores da semana. */
model GamificationSettings {
  id String @id @default("singleton") // linha única de configuração global

  /// Array de { label: string; points: number; weight: number } — cada entrada é um
  /// prêmio sorteável na Roleta Semanal, com rótulo livre (ex: "Cupom de desconto"),
  /// os pontos aplicados, e o peso relativo no sorteio (chance = weight / soma dos weights).
  spinPrizes Json @default("[{\"label\":\"10 pontos\",\"points\":10,\"weight\":1},{\"label\":\"20 pontos\",\"points\":20,\"weight\":1},{\"label\":\"30 pontos\",\"points\":30,\"weight\":1},{\"label\":\"50 pontos\",\"points\":50,\"weight\":1},{\"label\":\"100 pontos\",\"points\":100,\"weight\":1}]")

  updatedAt DateTime @updatedAt

  @@map("gamification_settings")
}

/** Configuração de cada método de pagamento disponível (id = "mercadopago" | "pix"). */
model PaymentMethodConfig {
  id      String  @id // "mercadopago" | "pix"
  enabled Boolean @default(false)
  config  Json    @default("{}") // campos específicos do método (chaves, tokens, etc.)

  updatedAt DateTime @updatedAt

  @@map("payment_method_configs")
}

model AiUsageLog {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  feature           String // expense_parsing | monthly_insight | nl_query | voice_transcription
  model             String
  promptTokens      Int?
  completionTokens  Int?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([feature])
  @@map("ai_usage_logs")
}
